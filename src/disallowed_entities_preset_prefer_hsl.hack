namespace HTL\PhaLinters;

/**
 * Prefer HSL and HHVM async APIs over PHP builtins.
 * Short namespace aliases below refer to HH\Lib.
 * Migration advice only; argument order, types, and behavior can differ.
 */
function disallowed_entities_preset_prefer_hsl()[]: TDisallowedEntities {
  return shape(
    'functions' => dict[
      // Containers.
      'count' => 'C\count',
      'sizeof' => 'C\count',
      'array_key_exists' => 'C\contains_key',
      'key_exists' => 'C\contains_key',
      'in_array' => 'C\contains; strict comparisons',
      'array_search' => 'C\find_key',
      'array_keys' => 'Vec\keys',
      'array_values' => 'vec($container)',
      'array_map' => 'Vec\map or Dict\map',
      'array_filter' => 'Vec\filter or Dict\filter',
      'array_reduce' => 'C\reduce',
      'array_merge' => 'Vec\concat or Dict\merge',
      'array_replace' => 'Dict\merge; later dictionaries win',
      'array_slice' => 'Vec\slice or Dict\drop() |> Dict\take()',
      'array_reverse' => 'Vec\reverse or Dict\reverse',
      'array_unique' => 'Vec\unique or Dict\unique; Dict last key, PHP first',
      'array_diff' => 'Vec\diff; strict comparisons',
      'array_diff_key' => 'Dict\diff_by_key',
      'array_intersect' => 'Vec\intersect; strict comparisons',
      'array_flip' => 'Dict\flip',
      'array_combine' => 'Dict\associate; unequal lengths throw',
      'array_count_values' => 'Dict\count_values',
      'array_fill' => 'Vec\fill or Dict\fill_keys',
      'array_fill_keys' => 'Dict\fill_keys',
      'array_chunk' => 'Vec\chunk or Dict\chunk',
      'array_sum' => 'Math\sum or Math\sum_float',
      'array_column' => 'Vec\map or Dict\pull; handle missing fields',
      'array_pop' => 'C\pop_back or C\pop_backx',
      'array_shift' => 'C\pop_front or C\pop_frontx',
      'sort' => 'Vec\sort',
      'rsort' => 'Vec\sort; descending comparator',
      'asort' => 'Dict\sort',
      'arsort' => 'Dict\sort; descending comparator',
      'ksort' => 'Dict\sort_by_key',
      'krsort' => 'Dict\sort_by_key; descending comparator',
      'usort' => 'Vec\sort',
      'uasort' => 'Dict\sort',
      'uksort' => 'Dict\sort_by_key',
      'shuffle' => 'Vec\shuffle',
      'range' => 'Vec\range',

      // Strings.
      'strlen' => 'Str\length',
      'substr' => 'Str\slice; check bounds',
      'substr_replace' => 'Str\splice',
      'strpos' => 'Str\search or Str\contains',
      'stripos' => 'Str\search_ci',
      'strrpos' => 'Str\search_last; review offsets',
      'strstr' => 'Str\search + Str\slice',
      'strchr' => 'Str\search + Str\slice',
      'stristr' => 'Str\search_ci + Str\slice',
      'strtolower' => 'Str\lowercase or Str\lowercase_l',
      'strtoupper' => 'Str\uppercase or Str\uppercase_l',
      'ucfirst' => 'Str\capitalize or Str\capitalize_l',
      'ucwords' => 'Str\capitalize_words or Str\capitalize_words_l',
      'trim' => 'Str\trim',
      'ltrim' => 'Str\trim_left',
      'rtrim' => 'Str\trim_right',
      'chop' => 'Str\trim_right',
      'explode' => 'Str\split; review negative limits',
      'implode' => 'Str\join',
      'join' => 'Str\join',
      'str_split' => 'Str\chunk',
      'str_replace' => 'Str\replace or Str\replace_every',
      'str_ireplace' => 'Str\replace_ci or Str\replace_every_ci',
      'str_repeat' => 'Str\repeat',
      'strrev' => 'Str\reverse or Str\reverse_l',
      'strcmp' => 'Str\compare',
      'strcasecmp' => 'Str\compare_ci or Str\compare_ci_l',
      'strncmp' => 'Str\slice both strings to $length, then Str\compare',
      'strncasecmp' => 'Str\slice both to $length, then Str\compare_ci',
      'str_pad' => 'Str\pad_left or Str\pad_right',
      'sprintf' => 'Str\format',
      'vsprintf' => 'Str\format',
      'number_format' => 'Str\format_number',

      // Multibyte APIs: UTF-8 locale; transcode other encodings.
      'mb_strlen' => 'Str\length_l; UTF-8 locale',
      'mb_substr' => 'Str\slice_l; UTF-8 locale; check bounds',
      'mb_strtolower' => 'Str\lowercase_l; UTF-8 locale; case rules differ',
      'mb_strtoupper' => 'Str\uppercase_l; UTF-8 locale; case rules differ',
      'mb_strpos' => 'Str\search_l; UTF-8 locale',
      'mb_stripos' => 'Str\search_ci_l; UTF-8 locale',
      'mb_strrpos' => 'Str\search_last_l; UTF-8 locale',
      'mb_strstr' => 'Str\search_l + Str\slice_l; UTF-8',
      'mb_stristr' => 'Str\search_ci_l + Str\slice_l; UTF-8',
      'mb_strrchr' => 'Str\search_last_l + Str\slice_l; UTF-8',

      // Numbers and randomness.
      'abs' => 'Math\abs',
      'ceil' => 'Math\ceil',
      'floor' => 'Math\floor',
      'round' => 'Math\round',
      'min' => 'Math\min or Math\minva',
      'max' => 'Math\max or Math\maxva',
      'intdiv' => 'Math\int_div',
      'is_nan' => 'Math\is_nan',
      'sqrt' => 'Math\sqrt; negative arguments throw',
      'sin' => 'Math\sin',
      'cos' => 'Math\cos',
      'tan' => 'Math\tan',
      'exp' => 'Math\exp',
      'log' => 'Math\log; positive argument; base > 0 and != 1',
      'base_convert' => 'Math\base_convert; invalid input rejected',
      'bindec' => 'Math\from_base($s, 2); check input and overflow',
      'octdec' => 'Math\from_base($s, 8); check input and overflow',
      'hexdec' => 'Math\from_base($s, 16); check input and overflow',
      'decbin' => 'Math\to_base($number, 2); nonnegative only',
      'decoct' => 'Math\to_base($number, 8); nonnegative only',
      'dechex' => 'Math\to_base($number, 16); nonnegative only',
      'rand' => 'PseudoRandom\int or SecureRandom\int for secrets',
      'mt_rand' => 'PseudoRandom\int or SecureRandom\int for secrets',
      'random_int' => 'SecureRandom\int',
      'random_bytes' => 'SecureRandom\string',

      // Regular expressions.
      'preg_match' => 'Regex\first_match or Regex\matches; re"..."',
      'preg_match_all' => 'Regex\every_match; re"..."',
      'preg_replace' => 'Regex\replace; re"..."',
      'preg_replace_callback' => 'Regex\replace_with; re"..."',
      'preg_split' => 'Regex\split; re"..."',

      // File APIs operate on local paths and use asynchronous handle methods.
      'file_get_contents' => 'File\open_read_only; local files',
      'file_put_contents' => 'File\open_write_only; local; TRUNCATE/APPEND',
      'fopen' => 'File\open_*; local files',
      'tmpfile' => 'File\temporary_file',

      // HHVM async APIs outside HH\Lib.
      'curl_exec' => 'HH\Asio\curl_exec',
      'curl_multi_select' => 'curl_multi_await',
      'sleep' => 'HH\Asio\usleep($seconds * 1_000_000)',
      'usleep' => 'HH\Asio\usleep',
      'mysql_connect' => 'AsyncMysqlClient::connect',
      'mysql_connect_with_db' => 'AsyncMysqlClient::connect',
      'mysql_pconnect' => 'AsyncMysqlConnectionPool::connect',
      'mysql_pconnect_with_db' => 'AsyncMysqlConnectionPool::connect',
      'mysql_query' => 'AsyncMysqlConnection::queryAsync',
      'mysql_multi_query' => 'AsyncMysqlConnection::multiQuery',
    ],
    'constants' => dict[
      'PHP_INT_MAX' => 'Math\INT64_MAX',
      'PHP_INT_MIN' => 'Math\INT64_MIN',
      'NAN' => 'Math\NAN',
      'M_PI' => 'Math\PI; precision differs',
      'M_E' => 'Math\E; precision differs',
    ],
  );
}
